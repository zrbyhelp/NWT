LANGFUSE_WEB_IMAGE=ghcr.io/langfuse/langfuse:latest
LANGFUSE_WORKER_IMAGE=ghcr.io/langfuse/langfuse-worker:latest

LANGFUSE_NEXTAUTH_SECRET=replace-with-random-secret
LANGFUSE_SALT=replace-with-random-secret
LANGFUSE_ENCRYPTION_KEY=replace-with-64-character-hex-string
