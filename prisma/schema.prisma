generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum StoryScriptLibrarySource {
  SELF_CREATED
  COMMUNITY_ADDED
}

enum StoryMaterialCategory {
  MASK
  MAP
  ITEM
  CREATURE
  SCENE
}

enum StoryMaterialStyle {
  REALISTIC
  FANTASY
  SCI_FI
  MYSTERY
  CYBERPUNK
  CLASSICAL
  APOCALYPTIC
}

enum AppUserRole {
  USER
  ADMIN
}

model AppUser {
  id            String                    @id @default(cuid())
  slug          String                    @unique
  account       String?                   @unique
  passwordHash  String?                   @db.Text
  role          AppUserRole               @default(USER)
  displayName   String
  avatarUrl     String?                   @db.Text
  showAiThinking Boolean                  @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  scriptLibrary StoryScriptLibraryEntry[]
  materialLibrary StoryMaterialLibraryEntry[]
  conversations Conversation[]
  authSessions  AuthSession[]
  aiProviders   AiProvider[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StoryScript {
  id             String                    @id @default(cuid())
  slug           String                    @unique
  titleZh        String
  titleEn        String
  descriptionZh  String                    @db.Text
  descriptionEn  String                    @db.Text
  welcomeZh      String                    @db.Text
  welcomeEn      String                    @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  conversations  Conversation[]
  libraryEntries StoryScriptLibraryEntry[]
}

model StoryScriptLibraryEntry {
  id        String                   @id @default(cuid())
  userId    String
  user      AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scriptId  String
  script    StoryScript              @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  source    StoryScriptLibrarySource @default(COMMUNITY_ADDED)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([userId, scriptId])
  @@index([scriptId])
  @@index([userId, createdAt])
}

model StoryMaterial {
  id             String                      @id @default(cuid())
  slug           String                      @unique
  category       StoryMaterialCategory
  style          StoryMaterialStyle          @default(REALISTIC)
  titleZh        String
  titleEn        String
  descriptionZh  String                      @db.Text
  descriptionEn  String                      @db.Text
  previewUrl     String?                     @db.Text
  metadata       Json?
  communityVisible Boolean                   @default(true)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  libraryEntries StoryMaterialLibraryEntry[]

  @@index([category, createdAt])
  @@index([style, createdAt])
}

model StoryMaterialLibraryEntry {
  id         String                   @id @default(cuid())
  userId     String
  user       AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   StoryMaterial            @relation(fields: [materialId], references: [id], onDelete: Cascade)
  source     StoryScriptLibrarySource @default(COMMUNITY_ADDED)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@unique([userId, materialId])
  @@index([materialId])
  @@index([userId, createdAt])
}

model Conversation {
  id        String        @id @default(cuid())
  title     String
  userId    String
  user      AppUser       @relation(fields: [userId], references: [id])
  scriptId  String
  script    StoryScript   @relation(fields: [scriptId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@index([scriptId])
  @@index([updatedAt])
}

model ChatMessage {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                String
  content             String       @db.Text
  promptTokens        Int?
  completionTokens    Int?
  tokenUsageEstimated Boolean      @default(false)
  createdAt           DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AiProvider {
  id              String        @id @default(cuid())
  userId          String
  user            AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  baseUrl         String
  encryptedApiKey String?       @db.Text
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  llmModels       LlmModel[]
  vectorModels    VectorModel[]
  imageModels     ImageModel[]

  @@unique([userId, slug])
  @@index([userId, enabled])
}

model LlmModel {
  id            String     @id @default(cuid())
  providerId    String
  provider      AiProvider @relation(fields: [providerId], references: [id])
  displayName   String
  modelId       String
  temperature   Float      @default(0.7)
  enabled       Boolean    @default(true)
  isDefault     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([enabled, isDefault])
}

model VectorModel {
  id             String     @id @default(cuid())
  providerId     String
  provider       AiProvider @relation(fields: [providerId], references: [id])
  displayName    String
  modelId        String
  dimensions     Int
  maxInputTokens Int
  enabled        Boolean    @default(true)
  isDefault      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([enabled, isDefault])
}

model ImageModel {
  id           String     @id @default(cuid())
  providerId   String
  provider     AiProvider @relation(fields: [providerId], references: [id])
  displayName  String
  modelId      String
  enabled      Boolean    @default(true)
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([enabled, isDefault])
}
