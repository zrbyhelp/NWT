generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum StoryScriptLibrarySource {
  SELF_CREATED
  COMMUNITY_ADDED
}

enum StoryMaterialCategory {
  MASK
  MAP
  ITEM
  CREATURE
  SCENE
}

enum StoryMaterialStyle {
  REALISTIC
  FANTASY
  SCI_FI
  MYSTERY
  CYBERPUNK
  CLASSICAL
  APOCALYPTIC
}

enum AppUserRole {
  USER
  ADMIN
}

model AppUser {
  id            String                    @id @default(cuid())
  slug          String                    @unique
  account       String?                   @unique
  externalUserId String?                  @unique
  email         String?                   @db.VarChar(191)
  username      String?                   @db.VarChar(191)
  passwordHash  String?                   @db.Text
  role          AppUserRole               @default(USER)
  displayName   String
  avatarUrl     String?                   @db.Text
  status        String                    @default("ACTIVE") @db.VarChar(32)
  showAiThinking Boolean                  @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  scriptLibrary StoryScriptLibraryEntry[]
  materialLibrary StoryMaterialLibraryEntry[]
  ownedMaterials StoryMaterial[]          @relation("StoryMaterialOwner")
  conversations Conversation[]
  authSessions  AuthSession[]
  aiProviders   AiProvider[]
  instantMeshConfigs InstantMeshConfig[]
  directMessageThreadsAsA DirectMessageThread[] @relation("DirectMessageThreadParticipantA")
  directMessageThreadsAsB DirectMessageThread[] @relation("DirectMessageThreadParticipantB")
  sentDirectMessages DirectMessage[]      @relation("DirectMessageSender")
  receivedDirectMessages DirectMessage[]  @relation("DirectMessageRecipient")

  @@index([email])
  @@index([username])
  @@index([status])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StoryScript {
  id             String                    @id @default(cuid())
  slug           String                    @unique
  titleZh        String
  titleEn        String
  descriptionZh  String                    @db.Text
  descriptionEn  String                    @db.Text
  welcomeZh      String                    @db.Text
  welcomeEn      String                    @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  conversations  Conversation[]
  libraryEntries StoryScriptLibraryEntry[]
}

model StoryScriptLibraryEntry {
  id        String                   @id @default(cuid())
  userId    String
  user      AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scriptId  String
  script    StoryScript              @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  source    StoryScriptLibrarySource @default(COMMUNITY_ADDED)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([userId, scriptId])
  @@index([scriptId])
  @@index([userId, createdAt])
}

model StoryMaterial {
  id             String                      @id @default(cuid())
  slug           String                      @unique
  ownerUserId    String
  ownerUser      AppUser                     @relation("StoryMaterialOwner", fields: [ownerUserId], references: [id])
  category       StoryMaterialCategory
  style          StoryMaterialStyle          @default(REALISTIC)
  titleZh        String
  titleEn        String
  descriptionZh  String                      @db.Text
  descriptionEn  String                      @db.Text
  previewUrl     String?                     @db.Text
  metadata       Json?
  communityVisible Boolean                   @default(true)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  libraryEntries StoryMaterialLibraryEntry[]

  @@index([ownerUserId, createdAt])
  @@index([category, createdAt])
  @@index([style, createdAt])
}

model StoryMaterialLibraryEntry {
  id         String                   @id @default(cuid())
  userId     String
  user       AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   StoryMaterial            @relation(fields: [materialId], references: [id], onDelete: Cascade)
  source     StoryScriptLibrarySource @default(COMMUNITY_ADDED)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@unique([userId, materialId])
  @@index([materialId])
  @@index([userId, createdAt])
}

model Conversation {
  id        String        @id @default(cuid())
  title     String
  userId    String
  user      AppUser       @relation(fields: [userId], references: [id])
  scriptId  String
  script    StoryScript   @relation(fields: [scriptId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@index([scriptId])
  @@index([updatedAt])
}

model ChatMessage {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                String
  content             String       @db.Text
  promptTokens        Int?
  completionTokens    Int?
  tokenUsageEstimated Boolean      @default(false)
  createdAt           DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model DirectMessageThread {
  id             String          @id @default(cuid())
  participantAId String
  participantA   AppUser         @relation("DirectMessageThreadParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   AppUser         @relation("DirectMessageThreadParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages       DirectMessage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([participantAId, participantBId])
  @@index([participantAId, updatedAt])
  @@index([participantBId, updatedAt])
}

model DirectMessage {
  id          String              @id @default(cuid())
  threadId    String
  thread      DirectMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      AppUser             @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   AppUser             @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String              @db.Text
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([threadId, createdAt])
  @@index([recipientId, readAt, createdAt])
}

model AiProvider {
  id              String        @id @default(cuid())
  userId          String
  user            AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  baseUrl         String
  encryptedApiKey String?       @db.Text
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  llmModels       LlmModel[]
  vectorModels    VectorModel[]
  imageModels     ImageModel[]

  @@unique([userId, slug])
  @@index([userId, enabled])
}

model LlmModel {
  id            String     @id @default(cuid())
  providerId    String
  provider      AiProvider @relation(fields: [providerId], references: [id])
  displayName   String
  modelId       String
  temperature   Float      @default(0.7)
  enabled       Boolean    @default(true)
  isDefault     Boolean    @default(false)
  isGlobal      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([enabled, isDefault])
  @@index([isGlobal, enabled, isDefault])
}

model VectorModel {
  id             String     @id @default(cuid())
  providerId     String
  provider       AiProvider @relation(fields: [providerId], references: [id])
  displayName    String
  modelId        String
  dimensions     Int
  maxInputTokens Int
  enabled        Boolean    @default(true)
  isDefault      Boolean    @default(false)
  isGlobal       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([enabled, isDefault])
  @@index([isGlobal, enabled, isDefault])
}

model ImageModel {
  id           String     @id @default(cuid())
  providerId   String
  provider     AiProvider @relation(fields: [providerId], references: [id])
  displayName  String
  modelId      String
  enabled      Boolean    @default(true)
  isDefault    Boolean    @default(false)
  isGlobal     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([enabled, isDefault])
  @@index([isGlobal, enabled, isDefault])
}

model InstantMeshConfig {
  id                 String   @id @default(cuid())
  userId             String
  user               AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  baseUrl            String
  encryptedApiKey    String?  @db.Text
  submitPath         String   @default("/api/instantmesh/tasks")
  statusPathTemplate String   @default("/api/instantmesh/tasks/{taskId}")
  pollIntervalMs     Int      @default(1500)
  timeoutSeconds     Int      @default(900)
  enabled            Boolean  @default(true)
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, enabled, isDefault])
  @@index([userId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
